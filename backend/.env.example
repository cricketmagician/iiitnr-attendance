# Copy to .env and fill in.
ATT_DATABASE_URL=mysql+pymysql://att_user:CHANGE_ME@localhost/iiitnr
# or: postgresql+psycopg://att_user:CHANGE_ME@localhost/iiitnr

# Tokens from the IIITNR app's existing login service
ATT_JWT_ALGORITHM=HS256
ATT_JWT_SECRET=CHANGE_ME_same_secret_as_the_login_service
# For RS256/ES256 put the issuer's public key (PEM) here instead and set the algorithm:
# ATT_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ATT_JWT_EMAIL_CLAIM=email
ATT_INSTITUTE_DOMAIN=iiitnr.edu.in

# Behind nginx: read the client IP from X-Forwarded-For (see README for the nginx lines)
ATT_TRUST_PROXY=true
# If nginx forwards /attendance/... without stripping the prefix:
# ATT_PATH_PREFIX=/attendance

# Used only until campus networks are added in the admin screen
ATT_CAMPUS_CIDRS=10.0.0.0/8

ATT_GO_LIVE_DATE=2027-01-04
ATT_UPLOAD_DIR=/srv/att/uploads

# Daily review list by e-mail (optional)
ATT_SMTP_HOST=
ATT_SMTP_PORT=587
ATT_SMTP_USER=
ATT_SMTP_PASSWORD=
ATT_SMTP_FROM=
ATT_ADMIN_NOTIFY_EMAIL=attendance.office@iiitnr.edu.in

# Run the 18:35 day-close inside the API process (or use cron instead)
ATT_RUN_SCHEDULER=false
ATT_DEV_MODE=false
ATT_ENFORCE_DEVICE_LOCK=true

# Guard kiosk: open /guard?key=<this value> on the guard desk screen
ATT_KIOSK_KEY=CHANGE_ME_random_kiosk_key
# Optional separate key for guard QR signatures (default: derived from ATT_JWT_SECRET)
# ATT_QR_SECRET=

# Photo / screen check on attendance selfies (needs models/MiniFASNetV2.onnx from download_models.sh)
# review: ask to retake, after ATT_LIVENESS_RETRIES failures save it for the office to check
# reject: always refuse    off: do not check
ATT_LIVENESS_MODE=review
ATT_LIVENESS_THRESHOLD=0.5
ATT_LIVENESS_RETRIES=2
# Guard Bluetooth beacon: unset = required outside dev mode; true/false to force
# ATT_REQUIRE_BLE=true
